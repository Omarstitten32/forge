     1	#include "forge/core/log.hpp"
     2	#include "forge/core/error.hpp"
     3	#include "forge/frontend/onnx_parser.hpp"
     4	#include "forge/optimizer/optimizer.hpp"
     5	#include "forge/codegen/codegen.hpp"
     6	
     7	#include <CLI/CLI.hpp>
     8	#include <cstdint>
     9	#include <spdlog/spdlog.h>
    10	#include <iomanip>
    11	#include <sstream>
    12	#include <cstdio>
    13	
    14	
    15	// ==========================================================
    16	// FNV-1a 64-bit hash (for tensor verification)
    17	// ==========================================================
    18	static std::uint64_t fnv1a_64(const std::uint8_t* data, std::size_t len) {
    19	    std::uint64_t h = 0xcbf29ce484222325ULL;
    20	    for (std::size_t i = 0; i < len; ++i) {
    21	        h ^= static_cast<std::uint64_t>(data[i]);
    22	        h *= 0x100000001b3ULL;
    23	    }
    24	    return h;
    25	}
    26	
    27	int main(int argc, char** argv) {
    28	    forge::init_logging();
    29	
    30	    CLI::App app{"Forge - AI model compiler for ARM64"};
    31	    app.set_version_flag("--version", "Forge v0.1.0 (aarch64)");
    32	    app.usage("USAGE:  forge [OPTIONS] <model.onnx>");
    33	    app.footer(
    34	        "EXAMPLES:\n"
    35	        "  forge model.onnx                     Analyze with default backend\n"
    36	        "  forge model.onnx --backend=neon      Use ARM NEON (SIMD)\n"
    37	        "  forge model.onnx --backend=sve       Use ARM SVE/SVE2\n"
    38	        "  forge model.onnx --backend=apu       Use MediaTek APU\n"
    39	        "  forge model.onnx --backend=vulkan    Use Mali GPU\n"
    40	        "  forge model.onnx -o generated.c      Save generated code\n"
    41	        "\n"
    42	        "SUPPORTED FORMATS:\n"
    43	        "  .onnx    ONNX models (Opset 7 through 17+)\n"
    44	        "\n"
    45	        "EXIT CODES:\n"
    46	        "  0    Success\n"
    47	        "  1    Invalid model or parse error\n"
    48	        "  2    Unexpected runtime error\n"
    49	    );
    50	
    51	    std::string input;
    52	    std::string output;
    53	    std::string backend = "neon";
    54	
    55	    app.add_option("input", input, "Input model file (.onnx)")->required();
    56	    app.add_option("-o,--output", output, "Output file");
    57	    app.add_option("-b,--backend", backend, "Backend: neon|sve|apu|vulkan")
    58	        ->check(CLI::IsMember({"neon", "sve", "apu", "vulkan"}));
    59	
    60	    bool verify_tensors = false;
    61	    app.add_flag("--verify-tensors", verify_tensors,
    62	        "Print per-tensor metadata + FNV-1a hash (for validation)");
    63	
    64	    CLI11_PARSE(app, argc, argv);
    65	
    66	    spdlog::info("Forge v0.1.0");
    67	    spdlog::info("Input:   {}", input);
    68	    spdlog::info("Backend: {}", backend);
    69	    spdlog::info("");
    70	
    71	    try {
    72	        auto result = forge::frontend::parse_onnx(input);
    73	        const auto& m = result.metadata;
    74	
    75	        // Metadata report
    76	        spdlog::info("═══════ ONNX Metadata ═══════");
    77	        spdlog::info("  Producer   : {} {}", m.producer_name, m.producer_version);
    78	        spdlog::info("  IR version : {}", m.ir_version);
    79	        spdlog::info("  Opset      : {}", m.opset_version);
    80	        spdlog::info("  Nodes      : {}", m.node_count);
    81	        spdlog::info("  Initializers: {}", m.initializer_count);
    82	        spdlog::info("  Inputs     : {}", m.input_count);
    83	        spdlog::info("  Outputs    : {}", m.output_count);
    84	        spdlog::info("");
    85	
    86	        spdlog::info("═══════ IR Graph ═══════");
    87	        spdlog::info("  {}", result.graph.summary());
    88	
    89	        // ---- Tensor verification mode ----
    90	        if (verify_tensors) {
    91	            std::cout << "=== TENSOR_VERIFY_START ===" << std::endl;
    92	            for (const auto& t : result.graph.tensors()) {
    93	                std::uint64_t h = 0;
    94	                if (t.has_data()) {
    95	                    h = fnv1a_64(t.data(), t.byte_size());
    96	                }
    97	                char buf[32];
    98	                std::snprintf(buf, sizeof(buf), "%016llx",
    99	                              (unsigned long long)h);
   100	
   101	                // Format: name | dtype | rank | dims | bytes | hash
   102	                std::ostringstream line;
   103	                line << "TENSOR|" << t.name() << "|"
   104	                     << forge::ir::dtype_name(t.dtype()) << "|";
   105	                for (std::size_t i = 0; i < t.shape().dims.size(); ++i) {
   106	                    if (i) line << ",";
   107	                    line << t.shape().dims[i];
   108	                }
   109	                line << "|" << t.byte_size()
   110	                     << "|" << buf;
   111	                std::cout << line.str() << std::endl;
   112	            }
   113	            std::cout << "=== TENSOR_VERIFY_END ===" << std::endl;
   114	        }
   115	
   116	        // Show first few tensors with data
   117	        std::size_t shown = 0;
   118	        for (const auto& t : result.graph.tensors()) {
   119	            if (t.has_data() && shown < 5) {
   120	                spdlog::info("    - {}", t.summary());
   121	                ++shown;
   122	            }
   123	        }
   124	        if (shown == 0) {
   125	            spdlog::info("    (no tensors with data)");
   126	        }
   127	        spdlog::info("");
   128	
   129	        auto stats = forge::optimizer::optimize(result.graph);
   130	        spdlog::info("Optimization: {} -> {} nodes",
   131	                     stats.nodes_before, stats.nodes_after);
   132	
   133	        auto backend_enum = forge::codegen::Backend::NEON;
   134	        if      (backend == "sve")    backend_enum = forge::codegen::Backend::SVE;
   135	        else if (backend == "apu")    backend_enum = forge::codegen::Backend::APU;
   136	        else if (backend == "vulkan") backend_enum = forge::codegen::Backend::Vulkan;
   137	
   138	        auto code = forge::codegen::generate(result.graph, backend_enum);
   139	        spdlog::info("Generated {} bytes of code", code.size());
   140	
   141	        if (!output.empty()) {
   142	            std::ofstream out(output);
   143	            if (!out) {
   144	                spdlog::error("Cannot write to {}", output);
   145	                return 1;
   146	            }
   147	            out << code;
   148	            spdlog::info("Written to {}", output);
   149	        }
   150	
   151	        return 0;
   152	    } catch (const forge::ForgeError& e) {
   153	        spdlog::error("{}", e.what());
   154	        return 1;
   155	    } catch (const std::exception& e) {
   156	        spdlog::error("Unexpected: {}", e.what());
   157	        return 2;
   158	    }
   159	}
