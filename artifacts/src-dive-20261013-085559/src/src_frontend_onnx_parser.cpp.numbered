    18	ir::DataType convert_dtype(int onnx_dtype) {
    19	    switch (onnx_dtype) {
    20	        case onnx::TensorProto_DataType_FLOAT:   return ir::DataType::F32;
    21	        case onnx::TensorProto_DataType_FLOAT16: return ir::DataType::F16;
    22	        case onnx::TensorProto_DataType_BFLOAT16:return ir::DataType::BF16;
    23	        case onnx::TensorProto_DataType_INT8:    return ir::DataType::I8;
    24	        case onnx::TensorProto_DataType_INT16:   return ir::DataType::I16;
    25	        case onnx::TensorProto_DataType_INT32:   return ir::DataType::I32;
    26	        case onnx::TensorProto_DataType_INT64:   return ir::DataType::I64;
    27	        case onnx::TensorProto_DataType_UINT8:   return ir::DataType::U8;
    28	        default:                                  return ir::DataType::Unknown;
    29	    }
    30	}
    31	
    32	ir::OpType convert_op(const std::string& op_type) {
    33	    static const std::unordered_map<std::string, ir::OpType> MAP = {
    34	        {"Add",       ir::OpType::Add},
    35	        {"Sub",       ir::OpType::Sub},
    36	        {"Mul",       ir::OpType::Mul},
    37	        {"Div",       ir::OpType::Div},
    38	        {"MatMul",    ir::OpType::MatMul},
    39	        {"Gemm",      ir::OpType::Gemm},
    40	        {"Conv",      ir::OpType::Conv2D},
    41	        {"Relu",      ir::OpType::Relu},
    42	        {"Sigmoid",   ir::OpType::Sigmoid},
    43	        {"Tanh",      ir::OpType::Tanh},
    44	        {"Softmax",   ir::OpType::Softmax},
    45	        {"Gelu",      ir::OpType::Gelu},
    46	        {"BatchNormalization",  ir::OpType::BatchNorm},
    47	        {"LayerNormalization",  ir::OpType::LayerNorm},
    48	        {"MaxPool",   ir::OpType::MaxPool},
    49	        {"AveragePool", ir::OpType::AvgPool},
    50	        {"Reshape",   ir::OpType::Reshape},
    51	        {"Transpose", ir::OpType::Transpose},
    52	        {"Concat",    ir::OpType::Concat},
    53	        {"Constant",  ir::OpType::Constant},
    54	    };
    55	    auto it = MAP.find(op_type);
    56	    return it != MAP.end() ? it->second : ir::OpType::Unknown;
    57	}
    58	
    59	void convert_attributes(const onnx::NodeProto& onnx_node, ir::Node& node) {
    60	    for (const auto& attr : onnx_node.attribute()) {
    61	        const auto& name = attr.name();
    62	        switch (attr.type()) {
    63	            case onnx::AttributeProto_AttributeType_INT:
    64	                node.attrs[name] = static_cast<std::int64_t>(attr.i());
    65	                break;
    66	            case onnx::AttributeProto_AttributeType_FLOAT:
    67	                node.attrs[name] = static_cast<double>(attr.f());
    68	                break;
    69	            case onnx::AttributeProto_AttributeType_STRING:
    70	                node.attrs[name] = attr.s();
    71	                break;
    72	            case onnx::AttributeProto_AttributeType_INTS: {
    73	                std::vector<std::int64_t> v;
    74	                v.reserve(attr.ints_size());
    75	                for (int i = 0; i < attr.ints_size(); ++i)
    76	                    v.push_back(static_cast<std::int64_t>(attr.ints(i)));
    77	                node.attrs[name] = std::move(v);
    78	                break;
    79	            }
    80	            case onnx::AttributeProto_AttributeType_FLOATS: {
    81	                std::vector<double> v;
    82	                v.reserve(attr.floats_size());
    83	                for (int i = 0; i < attr.floats_size(); ++i)
    84	                    v.push_back(static_cast<double>(attr.floats(i)));
    85	                node.attrs[name] = std::move(v);
    86	                break;
    87	            }
    88	            default: break;
    89	        }
    90	    }
    91	}
    92	
    93	ir::TensorInfo extract_tensor_info(const onnx::ValueInfoProto& vi) {
    94	    ir::TensorInfo info;
    95	    info.name = vi.name();
    96	
    97	    if (!vi.has_type()) return info;
    98	    const auto& type = vi.type();
    99	    if (!type.has_tensor_type()) return info;
   100	
   101	    const auto& tt = type.tensor_type();
   102	    info.dtype = convert_dtype(tt.elem_type());
   103	
   104	    if (tt.has_shape()) {
   105	        const auto& shape = tt.shape();
   106	        for (int i = 0; i < shape.dim_size(); ++i) {
   107	            const auto& d = shape.dim(i);
   108	            int64_t dim_value = 0;
   109	            if (d.has_dim_value()) {
   110	                dim_value = d.dim_value();
   111	            } else if (d.has_dim_param()) {
   112	                dim_value = -1;
   113	            }
   114	            info.shape.dims.push_back(dim_value);
   115	        }
   116	    }
   117	    return info;
   118	}
   119	
   120	// ==========================================================
   121	// Data extraction — NEW
   122	// ==========================================================
   123	std::vector<std::uint8_t> extract_raw_data(const onnx::TensorProto& t) {
   124	    std::vector<std::uint8_t> out;
   125	
   126	    // Case 1: raw_data provided (most common — pre-serialized bytes)
   127	    if (!t.raw_data().empty()) {
   128	        const auto& raw = t.raw_data();
   129	        out.assign(raw.begin(), raw.end());
   130	        return out;
   131	    }
   132	
   133	    // Case 2: typed arrays (older exporters)
   134	    ir::DataType dtype = convert_dtype(t.data_type());
   135	
   136	    std::size_t n = 1;
   137	    for (int i = 0; i < t.dims_size(); ++i) {
   138	        n *= static_cast<std::size_t>(t.dims(i));
   139	    }
   140	    if (n == 0) return out;
   141	
   142	    switch (dtype) {
   143	        case ir::DataType::F32: {
   144	            out.resize(n * 4);
   145	            for (std::size_t i = 0; i < n && i < (std::size_t)t.float_data_size(); ++i) {
   146	                float v = t.float_data(static_cast<int>(i));
   147	                std::memcpy(out.data() + i * 4, &v, 4);
   148	            }
   149	            break;
   150	        }
   151	        case ir::DataType::I32: {
   152	            out.resize(n * 4);
   153	            for (std::size_t i = 0; i < n && i < (std::size_t)t.int32_data_size(); ++i) {
   154	                int32_t v = t.int32_data(static_cast<int>(i));
   155	                std::memcpy(out.data() + i * 4, &v, 4);
   156	            }
   157	            break;
   158	        }
   159	        case ir::DataType::I64: {
   160	            out.resize(n * 8);
   161	            for (std::size_t i = 0; i < n && i < (std::size_t)t.int64_data_size(); ++i) {
   162	                int64_t v = t.int64_data(static_cast<int>(i));
   163	                std::memcpy(out.data() + i * 8, &v, 8);
   164	            }
   165	            break;
   166	        }
   167	        case ir::DataType::I8: {
   168	            out.resize(n);
   169	            for (std::size_t i = 0; i < n && i < (std::size_t)t.int32_data_size(); ++i) {
   170	                out[i] = static_cast<std::uint8_t>(t.int32_data(static_cast<int>(i)));
   171	            }
   172	            break;
   173	        }
   174	        case ir::DataType::U8: {
   175	            out.resize(n);
   176	            for (std::size_t i = 0; i < n && i < (std::size_t)t.uint64_data_size(); ++i) {
   177	                out[i] = static_cast<std::uint8_t>(t.uint64_data(static_cast<int>(i)));
   178	            }
   179	            break;
   180	        }
   181	        default:
   182	            // Unsupported type — leave data empty
   183	            break;
   184	    }
   185	
   186	    return out;
   187	}
   188	
   189	ir::Tensor extract_initializer_tensor(const onnx::TensorProto& t) {
   190	    ir::TensorInfo info;
   191	    info.name  = t.name();
   192	    info.dtype = convert_dtype(t.data_type());
   193	    for (int i = 0; i < t.dims_size(); ++i) {
   194	        info.shape.dims.push_back(t.dims(i));
   195	    }
   196	    auto raw = extract_raw_data(t);
   197	    return ir::Tensor(std::move(info), std::move(raw));
   198	}
   199	
   200	std::size_t extract_opset(const onnx::ModelProto& model) {
   201	    std::size_t v = 0;
   202	    for (int i = 0; i < model.opset_import_size(); ++i) {
   203	        auto cur = static_cast<std::size_t>(model.opset_import(i).version());
   204	        if (cur > v) v = cur;
   205	    }
   206	    return v;
   207	}
   208	
