   211	// ==========================================================
   212	// Public API
   213	// ==========================================================
   214	
   215	OnnxParseResult parse_onnx_bytes(const std::vector<std::uint8_t>& data) {
   216	    if (data.empty()) {
   217	        throw ParseError("Empty ONNX buffer");
   218	    }
   219	
   220	    onnx::ModelProto model;
   221	    if (!model.ParseFromArray(data.data(), static_cast<int>(data.size()))) {
   222	        throw ParseError("Failed to deserialize ONNX ModelProto (invalid binary)");
   223	    }
   224	
   225	    if (!model.has_graph()) {
   226	        throw ParseError("ONNX ModelProto has no GraphProto");
   227	    }
   228	
   229	    const auto& g = model.graph();
   230	
   231	    OnnxParseResult result;
   232	    auto& graph    = result.graph;
   233	    auto& metadata = result.metadata;
   234	
   235	    metadata.producer_name     = model.producer_name();
   236	    metadata.producer_version  = model.producer_version();
   237	    metadata.domain            = model.domain();
   238	    metadata.model_version     = model.model_version();
   239	    metadata.ir_version        = model.ir_version();
   240	    metadata.doc_string        = model.doc_string();
   241	    metadata.opset_version     = extract_opset(model);
   242	    metadata.node_count        = static_cast<std::size_t>(g.node_size());
   243	    metadata.initializer_count = static_cast<std::size_t>(g.initializer_size());
   244	    metadata.input_count       = static_cast<std::size_t>(g.input_size());
   245	    metadata.output_count      = static_cast<std::size_t>(g.output_size());
   246	
   247	    std::unordered_map<std::string, std::uint32_t> tensor_ids;
   248	
   249	    auto register_info = [&](ir::TensorInfo info) -> std::uint32_t {
   250	        auto id = graph.add_tensor(std::move(info));
   251	        tensor_ids[graph.tensor(id)->name] = id;
   252	        return id;
   253	    };
   254	
   255	    auto register_tensor = [&](ir::Tensor t) -> std::uint32_t {
   256	        auto name = t.name();
   257	        auto id = graph.add_tensor(std::move(t));
   258	        tensor_ids[name] = id;
   259	        return id;
   260	    };
   261	
   262	    // 1. Register initializers WITH DATA FIRST
   263	    //    (Opset 7 lists weights as inputs — initializers must win)
   264	    for (int i = 0; i < g.initializer_size(); ++i) {
   265	        auto t = extract_initializer_tensor(g.initializer(i));
   266	        if (tensor_ids.count(t.name())) continue;
   267	        register_tensor(std::move(t));
   268	    }
   269	
   270	    // 2. Register graph inputs (metadata only, skip if already registered)
   271	    for (int i = 0; i < g.input_size(); ++i) {
   272	        auto info = extract_tensor_info(g.input(i));
   273	        if (tensor_ids.count(info.name)) continue;
   274	        register_info(std::move(info));
   275	    }
   276	
   277	    // 3. Register graph outputs
   278	    for (int i = 0; i < g.output_size(); ++i) {
   279	        auto info = extract_tensor_info(g.output(i));
   280	        if (tensor_ids.count(info.name)) continue;
   281	        register_info(std::move(info));
   282	    }
   283	
   284	    // 4. Create nodes
   285	    for (int i = 0; i < g.node_size(); ++i) {
   286	        const auto& onnx_node = g.node(i);
   287	
   288	        ir::OpType op = convert_op(onnx_node.op_type());
   289	        std::string name = onnx_node.name().empty()
   290	            ? (onnx_node.op_type() + "_" + std::to_string(i))
   291	            : onnx_node.name();
   292	
   293	        auto node_id = graph.add_node(op, name);
   294	        auto* node   = graph.node(node_id);
   295	
   296	        convert_attributes(onnx_node, *node);
   297	
   298	        auto ensure_tensor = [&](const std::string& tname) -> std::uint32_t {
   299	            auto it = tensor_ids.find(tname);
   300	            if (it != tensor_ids.end()) return it->second;
   301	            ir::TensorInfo info;
   302	            info.name = tname;
   303	            info.dtype = ir::DataType::Unknown;
   304	            return register_info(std::move(info));
   305	        };
   306	
   307	        for (int j = 0; j < onnx_node.input_size(); ++j)
   308	            node->inputs.push_back(ensure_tensor(onnx_node.input(j)));
   309	        for (int j = 0; j < onnx_node.output_size(); ++j)
   310	            node->outputs.push_back(ensure_tensor(onnx_node.output(j)));
   311	    }
   312	
   313	    return result;
   314	}
   315	
   316	OnnxParseResult parse_onnx(const std::filesystem::path& path) {
   317	    std::ifstream in(path, std::ios::binary);
   318	    if (!in) {
   319	        throw ParseError("Cannot open file: " + path.string());
   320	    }
   321	
   322	    in.seekg(0, std::ios::end);
   323	    auto size = in.tellg();
   324	    in.seekg(0, std::ios::beg);
   325	
   326	    if (size <= 0) {
   327	        throw ParseError("File is empty: " + path.string());
   328	    }
   329	
   330	    std::vector<std::uint8_t> buffer(static_cast<std::size_t>(size));
   331	    if (!in.read(reinterpret_cast<char*>(buffer.data()), size)) {
   332	        throw ParseError("Failed to read: " + path.string());
   333	    }
   334	
   335	    return parse_onnx_bytes(buffer);
   336	}
