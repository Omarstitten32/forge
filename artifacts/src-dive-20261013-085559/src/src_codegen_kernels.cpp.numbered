     1	#include "forge/codegen/kernels.hpp"
     2	
     3	#include <cmath>
     4	#include <cstring>
     5	
     6	namespace forge::codegen {
     7	
     8	// ==========================================================
     9	//  Conv2D (naive)
    10	// ==========================================================
    11	void conv2d_f32_naive(
    12	    const float* input,
    13	    const float* weight,
    14	    const float* bias,
    15	    float* output,
    16	    std::size_t N,
    17	    std::size_t C_in, std::size_t H, std::size_t W,
    18	    std::size_t C_out,
    19	    std::size_t KH, std::size_t KW,
    20	    std::size_t stride_h, std::size_t stride_w,
    21	    std::size_t pad_top,  std::size_t pad_left,
    22	    std::size_t H_out, std::size_t W_out)
    23	{
    24	    for (std::size_t n = 0; n < N; ++n) {
    25	        for (std::size_t co = 0; co < C_out; ++co) {
    26	            const float b = bias ? bias[co] : 0.0f;
    27	
    28	            for (std::size_t oh = 0; oh < H_out; ++oh) {
    29	                for (std::size_t ow = 0; ow < W_out; ++ow) {
    30	                    float sum = b;
    31	
    32	                    for (std::size_t ci = 0; ci < C_in; ++ci) {
    33	                        for (std::size_t kh = 0; kh < KH; ++kh) {
    34	                            for (std::size_t kw = 0; kw < KW; ++kw) {
    35	                                const std::size_t ih = oh * stride_h + kh;
    36	                                const std::size_t iw = ow * stride_w + kw;
    37	
    38	                                // Padding check
    39	                                if (ih < pad_top || iw < pad_left) continue;
    40	                                const std::size_t y = ih - pad_top;
    41	                                const std::size_t x = iw - pad_left;
    42	                                if (y >= H || x >= W) continue;
    43	
    44	                                const std::size_t in_idx =
    45	                                    ((n * C_in + ci) * H + y) * W + x;
    46	                                const std::size_t w_idx =
    47	                                    ((co * C_in + ci) * KH + kh) * KW + kw;
    48	                                sum += input[in_idx] * weight[w_idx];
    49	                            }
    50	                        }
    51	                    }
    52	
    53	                    const std::size_t out_idx =
    54	                        ((n * C_out + co) * H_out + oh) * W_out + ow;
    55	                    output[out_idx] = sum;
    56	                }
    57	            }
    58	        }
    59	    }
    60	}
    61	
    62	// ==========================================================
    63	//  Gemm (naive)
    64	// ==========================================================
    65	void gemm_f32_naive(
    66	    const float* A,
    67	    const float* B,
    68	    const float* bias,
    69	    float* C,
    70	    std::size_t M, std::size_t K, std::size_t N,
    71	    float alpha, float beta,
    72	    bool transA, bool transB)
    73	{
    74	    for (std::size_t i = 0; i < M; ++i) {
    75	        for (std::size_t j = 0; j < N; ++j) {
    76	            float sum = 0.0f;
    77	
    78	            for (std::size_t k = 0; k < K; ++k) {
    79	                const float a = transA
    80	                    ? A[k * M + i]
    81	                    : A[i * K + k];
    82	                const float b = transB
    83	                    ? B[j * K + k]
    84	                    : B[k * N + j];
    85	                sum += a * b;
    86	            }
    87	
    88	            const float bias_val = bias ? bias[j] : 0.0f;
    89	            const float c_val    = C[i * N + j];
    90	
    91	            C[i * N + j] = alpha * sum + beta * c_val + bias_val;
    92	        }
    93	    }
    94	}
    95	
    96	// ==========================================================
    97	//  Element-wise ops
    98	// ==========================================================
    99	void relu_f32(const float* in, float* out, std::size_t n) {
   100	    for (std::size_t i = 0; i < n; ++i) {
   101	        out[i] = in[i] > 0.0f ? in[i] : 0.0f;
   102	    }
   103	}
   104	
   105	void sigmoid_f32(const float* in, float* out, std::size_t n) {
   106	    for (std::size_t i = 0; i < n; ++i) {
   107	        out[i] = 1.0f / (1.0f + std::exp(-in[i]));
   108	    }
   109	}
   110	
   111	void tanh_f32(const float* in, float* out, std::size_t n) {
   112	    for (std::size_t i = 0; i < n; ++i) {
   113	        out[i] = std::tanh(in[i]);
   114	    }
   115	}
   116	
   117	void gelu_f32(const float* in, float* out, std::size_t n) {
   118	    // tanh approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
   119	    constexpr float SQRT_2_OVER_PI = 0.7978845608f;
   120	    for (std::size_t i = 0; i < n; ++i) {
   121	        const float x = in[i];
   122	        const float x3 = x * x * x;
   123	        const float inner = SQRT_2_OVER_PI * (x + 0.044715f * x3);
   124	        out[i] = 0.5f * x * (1.0f + std::tanh(inner));
   125	    }
   126	}
   127	
   128	void add_f32(const float* a, const float* b, float* out, std::size_t n) {
   129	    for (std::size_t i = 0; i < n; ++i) {
   130	        out[i] = a[i] + b[i];
   131	    }
   132	}
   133	
   134	void mul_f32(const float* a, const float* b, float* out, std::size_t n) {
   135	    for (std::size_t i = 0; i < n; ++i) {
   136	        out[i] = a[i] * b[i];
   137	    }
   138	}
   139	
   140	// ==========================================================
   141	//  BatchNorm (inference)
   142	// ==========================================================
   143	void batchnorm_f32(
   144	    const float* in,
   145	    const float* gamma,
   146	    const float* beta,
   147	    const float* mean,
   148	    const float* var,
   149	    float* out,
   150	    std::size_t N, std::size_t C,
   151	    std::size_t H, std::size_t W,
   152	    float epsilon)
   153	{
   154	    for (std::size_t n = 0; n < N; ++n) {
   155	        for (std::size_t c = 0; c < C; ++c) {
   156	            const float inv_std = 1.0f / std::sqrt(var[c] + epsilon);
   157	            const float scale   = gamma[c] * inv_std;
   158	            const float shift   = beta[c] - mean[c] * scale;
   159	
   160	            for (std::size_t h = 0; h < H; ++h) {
   161	                for (std::size_t w = 0; w < W; ++w) {
   162	                    const std::size_t idx =
   163	                        ((n * C + c) * H + h) * W + w;
   164	                    out[idx] = in[idx] * scale + shift;
   165	                }
   166	            }
   167	        }
   168	    }
   169	}
   170	
   171	// ==========================================================
   172	//  MaxPool 2D
   173	// ==========================================================
   174	void maxpool2d_f32(
   175	    const float* in,
   176	    float* out,
   177	    std::size_t N, std::size_t C,
   178	    std::size_t H, std::size_t W,
   179	    std::size_t KH, std::size_t KW,
   180	    std::size_t stride_h, std::size_t stride_w,
   181	    std::size_t H_out, std::size_t W_out)
   182	{
   183	    for (std::size_t n = 0; n < N; ++n) {
   184	        for (std::size_t c = 0; c < C; ++c) {
   185	            for (std::size_t oh = 0; oh < H_out; ++oh) {
   186	                for (std::size_t ow = 0; ow < W_out; ++ow) {
   187	                    float best = -INFINITY;
   188	
   189	                    for (std::size_t kh = 0; kh < KH; ++kh) {
   190	                        for (std::size_t kw = 0; kw < KW; ++kw) {
   191	                            const std::size_t ih = oh * stride_h + kh;
   192	                            const std::size_t iw = ow * stride_w + kw;
   193	                            if (ih >= H || iw >= W) continue;
   194	
   195	                            const std::size_t idx =
   196	                                ((n * C + c) * H + ih) * W + iw;
   197	                            if (in[idx] > best) best = in[idx];
   198	                        }
   199	                    }
   200	
   201	                    const std::size_t out_idx =
   202	                        ((n * C + c) * H_out + oh) * W_out + ow;
   203	                    out[out_idx] = best;
   204	                }
   205	            }
   206	        }
   207	    }
   208	}
   209	
   210	// ==========================================================
   211	//  Flatten (NCHW -> [N, C*H*W]) — no reorder
   212	// ==========================================================
   213	void flatten_f32(const float* in, float* out, std::size_t n) {
   214	    std::memcpy(out, in, n * sizeof(float));
   215	}
   216	
   217	} // namespace forge::codegen
