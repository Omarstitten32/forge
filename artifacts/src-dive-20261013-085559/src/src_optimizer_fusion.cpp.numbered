     1	#include "forge/optimizer/fusion.hpp"
     2	#include "forge/optimizer/analysis.hpp"
     3	
     4	#include <unordered_map>
     5	#include <unordered_set>
     6	
     7	namespace forge::optimizer {
     8	
     9	// ==========================================================
    10	// Helpers
    11	// ==========================================================
    12	namespace {
    13	
    14	/// Count how many times a tensor is consumed by nodes.
    15	using UseMap = std::unordered_map<std::uint32_t, std::size_t>;
    16	
    17	/// Find the producer node of a tensor (UINT32_MAX if none).
    18	std::uint32_t producer_of(const ir::Graph& g,
    19	                          const std::unordered_map<std::uint32_t,
    20	                                                   std::uint32_t>& producers,
    21	                          std::uint32_t tid) {
    22	    auto it = producers.find(tid);
    23	    return (it == producers.end()) ? UINT32_MAX : it->second;
    24	}
    25	
    26	/// Return true if the given tensor has exactly one consumer in the graph.
    27	bool single_consumer(const UseMap& uses, std::uint32_t tid) {
    28	    auto it = uses.find(tid);
    29	    return it != uses.end() && it->second == 1;
    30	}
    31	
    32	} // anonymous namespace
    33	
    34	// ==========================================================
    35	// Pattern: Conv2D + Relu
    36	// ==========================================================
    37	bool try_fuse_conv_relu(ir::Graph& g,
    38	                        std::uint32_t conv_id,
    39	                        std::uint32_t relu_id) {
    40	    auto* conv = g.node(conv_id);
    41	    auto* relu = g.node(relu_id);
    42	    if (!conv || !relu) return false;
    43	    if (conv->op != ir::OpType::Conv2D) return false;
    44	    if (relu->op != ir::OpType::Relu)   return false;
    45	
    46	    // Conv must have exactly 1 output; Relu must have exactly 1 input
    47	    if (conv->outputs.size() != 1) return false;
    48	    if (relu->inputs.size()  != 1) return false;
    49	    if (relu->outputs.empty())     return false;
    50	
    51	    // The single output of Conv must be the single input of Relu
    52	    if (conv->outputs[0] != relu->inputs[0]) return false;
    53	
    54	    // The intermediate tensor must be consumed only by Relu
    55	    auto uses = count_tensor_uses(g);
    56	    if (!single_consumer(uses, conv->outputs[0])) return false;
    57	
    58	    // Perform fusion
    59	    auto out_tensor = relu->outputs.empty() ? UINT32_MAX : relu->outputs[0];
    60	    if (out_tensor == UINT32_MAX) return false;
    61	
    62	    // Conv keeps its inputs (weight, input, bias)
    63	    // Relu's output becomes Conv's output
    64	    conv->outputs = relu->outputs;
    65	    conv->op      = ir::OpType::Conv2DRelu;
    66	
    67	    // Mark relu as dead — its role is now subsumed
    68	    g.mark_node_dead(relu_id);
    69	    return true;
    70	}
    71	
    72	// ==========================================================
    73	// Pattern: Conv2D + BatchNorm
    74	// ==========================================================
    75	bool try_fuse_conv_bn(ir::Graph& g,
    76	                      std::uint32_t conv_id,
    77	                      std::uint32_t bn_id) {
    78	    auto* conv = g.node(conv_id);
    79	    auto* bn   = g.node(bn_id);
    80	    if (!conv || !bn) return false;
    81	    if (conv->op != ir::OpType::Conv2D)    return false;
    82	    if (bn->op   != ir::OpType::BatchNorm) return false;
    83	
    84	    if (conv->outputs.size() != 1) return false;
    85	    if (bn->inputs.empty())        return false;
    86	    if (bn->outputs.size() != 1)   return false;
    87	
    88	    // BN's FIRST input must be Conv's single output.
    89	    if (conv->outputs[0] != bn->inputs[0]) return false;
    90	
    91	    auto uses = count_tensor_uses(g);
    92	    if (!single_consumer(uses, conv->outputs[0])) return false;
    93	
    94	    // Fuse: Conv keeps inputs (weight, input, bias), BN adds (scale, offset, mean, var)
    95	    // We append BN's inputs (beyond the fused intermediate) to Conv's inputs.
    96	    for (auto tid : bn->inputs) {
    97	        if (tid == conv->outputs[0]) continue;  // skip the intermediate
    98	        conv->inputs.push_back(tid);
    99	    }
   100	    conv->outputs = bn->outputs;
   101	    conv->op      = ir::OpType::Conv2DBatchNorm;
   102	
   103	    g.mark_node_dead(bn_id);
   104	    return true;
   105	}
   106	
   107	// ==========================================================
   108	// Pattern: Conv2D + BatchNorm + Relu (chain)
   109	// ==========================================================
   110	bool try_fuse_conv_bn_relu(ir::Graph& g,
   111	                           std::uint32_t conv_id,
   112	                           std::uint32_t bn_id,
   113	                           std::uint32_t relu_id) {
   114	    auto* conv = g.node(conv_id);
   115	    auto* bn   = g.node(bn_id);
   116	    auto* relu = g.node(relu_id);
   117	    if (!conv || !bn || !relu) return false;
   118	    if (conv->op != ir::OpType::Conv2D)    return false;
   119	    if (bn->op   != ir::OpType::BatchNorm) return false;
   120	    if (relu->op != ir::OpType::Relu)      return false;
   121	
   122	    if (conv->outputs.size() != 1)  return false;
   123	    if (bn->inputs.empty())         return false;
   124	    if (bn->outputs.size()  != 1)   return false;
   125	    if (relu->inputs.size() != 1)   return false;
   126	    if (relu->outputs.size()!= 1)   return false;
   127	
   128	    // BN's first input must be Conv's output
   129	    if (conv->outputs[0] != bn->inputs[0])   return false;
   130	    // Relu's only input must be BN's output
   131	    if (bn->outputs[0]   != relu->inputs[0]) return false;
   132	
   133	    auto uses = count_tensor_uses(g);
   134	    if (!single_consumer(uses, conv->outputs[0])) return false;
   135	    if (!single_consumer(uses, bn->outputs[0]))   return false;
   136	
   137	    // Fuse all three
   138	    for (auto tid : bn->inputs) {
   139	        if (tid == conv->outputs[0]) continue;
   140	        conv->inputs.push_back(tid);
   141	    }
   142	    conv->outputs = relu->outputs;
   143	    conv->op      = ir::OpType::Conv2DBatchNormRelu;
   144	
   145	    g.mark_node_dead(bn_id);
   146	    g.mark_node_dead(relu_id);
   147	    return true;
   148	}
   149	
   150	// ==========================================================
   151	// Pattern: Add + Relu
   152	// ==========================================================
   153	bool try_fuse_add_relu(ir::Graph& g,
   154	                       std::uint32_t add_id,
   155	                       std::uint32_t relu_id) {
   156	    auto* add  = g.node(add_id);
   157	    auto* relu = g.node(relu_id);
   158	    if (!add || !relu) return false;
   159	    if (add->op  != ir::OpType::Add)  return false;
   160	    if (relu->op != ir::OpType::Relu) return false;
   161	
   162	    if (add->outputs.size() != 1) return false;
   163	    if (relu->inputs.size() != 1) return false;
   164	    if (add->outputs[0] != relu->inputs[0]) return false;
   165	
   166	    auto uses = count_tensor_uses(g);
   167	    if (!single_consumer(uses, add->outputs[0])) return false;
   168	
   169	    add->outputs = relu->outputs;
   170	    add->op      = ir::OpType::AddRelu;
   171	
   172	    g.mark_node_dead(relu_id);
   173	    return true;
   174	}
   175	
   176	// ==========================================================
   177	// Main fusion pass
   178	// ==========================================================
   179	FusionStats pass_operator_fusion(ir::Graph& g) {
   180	    FusionStats stats;
   181	    bool changed = true;
   182	
   183	    while (changed) {
   184	        changed = false;
   185	
   186	        // Build consumer map: tensor_id -> id of node that uses it as input.
   187	        std::unordered_map<std::uint32_t, std::uint32_t> consumers;
   188	        for (const auto& n : g.nodes()) {
   189	            if (n.name == "__dead__") continue;
   190	            for (auto tid : n.inputs) {
   191	                consumers[tid] = n.id;
   192	            }
   193	        }
   194	
   195	        auto uses  = count_tensor_uses(g);
   196	        auto order = topological_sort(g);
   197	
   198	        for (auto node_id : order) {
   199	            auto* node = g.node(node_id);
   200	            if (!node) continue;
   201	            if (node->name == "__dead__") continue;
   202	
   203	            // -------- Try Conv + BN + Relu (3-op chain) --------
   204	            if (node->op == ir::OpType::Conv2D
   205	                && node->outputs.size() == 1) {
   206	                auto mid_tensor = node->outputs[0];
   207	                if (single_consumer(uses, mid_tensor)) {
   208	                    auto bn_id = consumers.count(mid_tensor)
   209	                                 ? consumers[mid_tensor] : UINT32_MAX;
   210	                    if (bn_id != UINT32_MAX) {
   211	                        auto* bn = g.node(bn_id);
   212	                        if (bn && bn->op == ir::OpType::BatchNorm
   213	                            && bn->outputs.size() == 1) {
   214	                            auto bn_out = bn->outputs[0];
   215	                            if (single_consumer(uses, bn_out)) {
   216	                                auto relu_id = consumers.count(bn_out)
   217	                                               ? consumers[bn_out] : UINT32_MAX;
   218	                                if (relu_id != UINT32_MAX) {
   219	                                    auto* relu = g.node(relu_id);
   220	                                    if (relu && relu->op == ir::OpType::Relu) {
   221	                                        if (try_fuse_conv_bn_relu(
   222	                                                g, node_id, bn_id, relu_id)) {
   223	                                            stats.fused_conv_bn_relu++;
   224	                                            stats.total_fusions++;
   225	                                            changed = true;
   226	                                            break;
   227	                                        }
   228	                                    }
   229	                                }
   230	                            }
   231	                        }
   232	                    }
   233	                }
   234	            }
   235	
   236	            // -------- Try Conv + Relu --------
   237	            if (node->op == ir::OpType::Conv2D
   238	                && node->outputs.size() == 1) {
   239	                auto mid = node->outputs[0];
   240	                if (single_consumer(uses, mid)) {
   241	                    auto next_id = consumers.count(mid)
   242	                                   ? consumers[mid] : UINT32_MAX;
   243	                    if (next_id != UINT32_MAX) {
   244	                        auto* next = g.node(next_id);
   245	                        if (next && next->op == ir::OpType::Relu) {
   246	                            if (try_fuse_conv_relu(g, node_id, next_id)) {
   247	                                stats.fused_conv_relu++;
   248	                                stats.total_fusions++;
   249	                                changed = true;
   250	                                break;
   251	                            }
   252	                        }
   253	                    }
   254	                }
   255	            }
   256	
   257	            // -------- Try Conv + BN --------
   258	            if (node->op == ir::OpType::Conv2D
   259	                && node->outputs.size() == 1) {
   260	                auto mid = node->outputs[0];
   261	                if (single_consumer(uses, mid)) {
   262	                    auto next_id = consumers.count(mid)
   263	                                   ? consumers[mid] : UINT32_MAX;
   264	                    if (next_id != UINT32_MAX) {
   265	                        auto* next = g.node(next_id);
   266	                        if (next && next->op == ir::OpType::BatchNorm) {
   267	                            if (try_fuse_conv_bn(g, node_id, next_id)) {
   268	                                stats.fused_conv_bn++;
   269	                                stats.total_fusions++;
   270	                                changed = true;
   271	                                break;
   272	                            }
   273	                        }
   274	                    }
   275	                }
   276	            }
   277	
   278	            // -------- Try Add + Relu --------
   279	            if (node->op == ir::OpType::Add
   280	                && node->outputs.size() == 1) {
   281	                auto mid = node->outputs[0];
   282	                if (single_consumer(uses, mid)) {
   283	                    auto next_id = consumers.count(mid)
   284	                                   ? consumers[mid] : UINT32_MAX;
   285	                    if (next_id != UINT32_MAX) {
   286	                        auto* next = g.node(next_id);
   287	                        if (next && next->op == ir::OpType::Relu) {
   288	                            if (try_fuse_add_relu(g, node_id, next_id)) {
   289	                                stats.fused_add_relu++;
   290	                                stats.total_fusions++;
   291	                                changed = true;
   292	                                break;
   293	                            }
   294	                        }
   295	                    }
   296	                }
   297	            }
   298	        }
   299	    }
   300	
   301	    return stats;
   302	}
   303	
   304	} // namespace forge::optimizer
