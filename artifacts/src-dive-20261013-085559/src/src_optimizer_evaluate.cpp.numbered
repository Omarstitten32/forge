     1	#include "forge/optimizer/evaluate.hpp"
     2	#include "forge/core/error.hpp"
     3	
     4	#include <cmath>
     5	#include <cstring>
     6	#include <limits>
     7	
     8	namespace forge::optimizer {
     9	
    10	// ==========================================================
    11	// Helpers
    12	// ==========================================================
    13	namespace {
    14	
    15	/// Copy info from a source tensor but keep the given name.
    16	ir::TensorInfo rename_info(const ir::Tensor& t, const std::string& name) {
    17	    ir::TensorInfo info = t.info();
    18	    info.name = name;
    19	    return info;
    20	}
    21	
    22	/// Verify shapes match element-wise.
    23	bool shapes_equal(const ir::Tensor& a, const ir::Tensor& b) {
    24	    return a.shape().dims == b.shape().dims;
    25	}
    26	
    27	/// Verify a tensor is F32 with data.
    28	bool is_f32_with_data(const ir::Tensor& t) {
    29	    return t.has_data() && t.dtype() == ir::DataType::F32;
    30	}
    31	
    32	} // anonymous namespace
    33	
    34	// ==========================================================
    35	// Element-wise binary operations
    36	// ==========================================================
    37	#define DEFINE_BINARY_OP(name, OP)                                              \
    38	ir::Tensor name(const ir::Tensor& a, const ir::Tensor& b) {                     \
    39	    if (!is_f32_with_data(a) || !is_f32_with_data(b)) {                         \
    40	        throw OptimizationError(#name ": requires F32 with data");              \
    41	    }                                                                            \
    42	    if (!shapes_equal(a, b)) {                                                   \
    43	        throw OptimizationError(#name ": shape mismatch");                      \
    44	    }                                                                            \
    45	    std::size_t n = a.element_count();                                           \
    46	    std::vector<std::uint8_t> out(n * 4);                                        \
    47	    const float* pa = a.as<float>();                                             \
    48	    const float* pb = b.as<float>();                                             \
    49	    float*       po = reinterpret_cast<float*>(out.data());                      \
    50	    for (std::size_t i = 0; i < n; ++i) {                                        \
    51	        po[i] = pa[i] OP pb[i];                                                  \
    52	    }                                                                            \
    53	    return ir::Tensor(a.info(), std::move(out));                                 \
    54	}
    55	
    56	DEFINE_BINARY_OP(eval_add, +)
    57	DEFINE_BINARY_OP(eval_sub, -)
    58	DEFINE_BINARY_OP(eval_mul, *)
    59	DEFINE_BINARY_OP(eval_div, /)
    60	
    61	#undef DEFINE_BINARY_OP
    62	
    63	// ==========================================================
    64	// Unary operations
    65	// ==========================================================
    66	ir::Tensor eval_relu(const ir::Tensor& a) {
    67	    if (!is_f32_with_data(a)) {
    68	        throw OptimizationError("eval_relu: requires F32 with data");
    69	    }
    70	    std::size_t n = a.element_count();
    71	    std::vector<std::uint8_t> out(n * 4);
    72	    const float* pa = a.as<float>();
    73	    float*       po = reinterpret_cast<float*>(out.data());
    74	    for (std::size_t i = 0; i < n; ++i) {
    75	        po[i] = pa[i] > 0.0f ? pa[i] : 0.0f;
    76	    }
    77	    return ir::Tensor(a.info(), std::move(out));
    78	}
    79	
    80	ir::Tensor eval_sigmoid(const ir::Tensor& a) {
    81	    if (!is_f32_with_data(a)) {
    82	        throw OptimizationError("eval_sigmoid: requires F32 with data");
    83	    }
    84	    std::size_t n = a.element_count();
    85	    std::vector<std::uint8_t> out(n * 4);
    86	    const float* pa = a.as<float>();
    87	    float*       po = reinterpret_cast<float*>(out.data());
    88	    for (std::size_t i = 0; i < n; ++i) {
    89	        po[i] = 1.0f / (1.0f + std::exp(-pa[i]));
    90	    }
    91	    return ir::Tensor(a.info(), std::move(out));
    92	}
    93	
    94	ir::Tensor eval_tanh(const ir::Tensor& a) {
    95	    if (!is_f32_with_data(a)) {
    96	        throw OptimizationError("eval_tanh: requires F32 with data");
    97	    }
    98	    std::size_t n = a.element_count();
    99	    std::vector<std::uint8_t> out(n * 4);
   100	    const float* pa = a.as<float>();
   101	    float*       po = reinterpret_cast<float*>(out.data());
   102	    for (std::size_t i = 0; i < n; ++i) {
   103	        po[i] = std::tanh(pa[i]);
   104	    }
   105	    return ir::Tensor(a.info(), std::move(out));
   106	}
   107	
   108	// ==========================================================
   109	// Generic evaluator
   110	// ==========================================================
   111	std::optional<ir::Tensor> try_evaluate(
   112	    const ir::Node& node,
   113	    const std::vector<const ir::Tensor*>& inputs,
   114	    const ir::TensorInfo& output_info
   115	) {
   116	    // All inputs must have data
   117	    for (auto* t : inputs) {
   118	        if (!t || !t->has_data()) return std::nullopt;
   119	    }
   120	
   121	    auto rename = [&](ir::Tensor t) {
   122	        ir::TensorInfo info = output_info;
   123	        // Preserve computed dtype/shape if it matches
   124	        info.dtype = t.dtype();
   125	        info.shape = t.shape();
   126	        return ir::Tensor(std::move(info), std::move(t).bytes());
   127	    };
   128	
   129	    try {
   130	        switch (node.op) {
   131	            case ir::OpType::Add:
   132	                if (inputs.size() == 2) return rename(eval_add(*inputs[0], *inputs[1]));
   133	                break;
   134	            case ir::OpType::Sub:
   135	                if (inputs.size() == 2) return rename(eval_sub(*inputs[0], *inputs[1]));
   136	                break;
   137	            case ir::OpType::Mul:
   138	                if (inputs.size() == 2) return rename(eval_mul(*inputs[0], *inputs[1]));
   139	                break;
   140	            case ir::OpType::Div:
   141	                if (inputs.size() == 2) return rename(eval_div(*inputs[0], *inputs[1]));
   142	                break;
   143	            case ir::OpType::Relu:
   144	                if (inputs.size() == 1) return rename(eval_relu(*inputs[0]));
   145	                break;
   146	            case ir::OpType::Sigmoid:
   147	                if (inputs.size() == 1) return rename(eval_sigmoid(*inputs[0]));
   148	                break;
   149	            case ir::OpType::Tanh:
   150	                if (inputs.size() == 1) return rename(eval_tanh(*inputs[0]));
   151	                break;
   152	            default:
   153	                return std::nullopt;
   154	        }
   155	    } catch (const OptimizationError&) {
   156	        return std::nullopt;
   157	    }
   158	    return std::nullopt;
   159	}
   160	
   161	} // namespace forge::optimizer
